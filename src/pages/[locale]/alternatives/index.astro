---
import AlternativesHub from "../../../components/AlternativesHub.astro";
import { DEFAULT_LOCALE, LOCALES, isLocale } from "../../../i18n/locales";
import type { Locale } from "../../../i18n/locales";

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
if (!isLocale(locale) || locale === DEFAULT_LOCALE) {
  throw new Error(`unsupported alternatives locale: ${locale}`);
}
---

<AlternativesHub locale={locale} />
