---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getSupportCopy } from "../i18n/support";
import { DEFAULT_LOCALE, isLocale } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_URL, SELF_HOST_GUIDE_PATH, SUPPORT_EMAIL } from "../site";

const locale: import("../i18n/locales").Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;
const copy = getSupportCopy(locale);
---

<BaseLayout title="Support · Doitx" description={copy.description} index={false}>
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>{copy.h1}</h1>
      <p>{copy.description}</p>
      <p>
        <a href={SELF_HOST_GUIDE_PATH}>Self-hosting guide</a>
        <br />
        {copy.emailNote}
      </p>
      <p>
        {copy.ticketNote}{" "}
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
      </p>
      <h2 id="account-deletion">{copy.accountDeletion.heading}</h2>
      <p>
        {copy.accountDeletion.lead} <a href={APP_URL}>{APP_URL.replace("https://", "")}</a>{" "}
        {copy.accountDeletion.trail}
      </p>
      <p>
        {copy.accountDeletion.requestLead}{" "}
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>{" "}
        {copy.accountDeletion.requestTrail}
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
