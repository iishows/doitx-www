---
import type { FaqItem } from "../alternatives";
import { faqPageSchema } from "../alternatives";
import { githubStarsLabel } from "../github";
import { getHomeCopy } from "../i18n/home";
import { DEFAULT_LOCALE, isLocale, type Locale } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

type Props = {
  title: string;
  description: string;
  faq?: readonly FaqItem[];
  structuredData?: object;
  ogImage?: string;
  ogType?: string;
  index?: boolean;
  wide?: boolean;
  markdownAlternate?: string;
  locale?: Locale;
  alternateLanguages?: { hreflang: string; href: string }[];
};

const {
  title,
  description,
  faq,
  structuredData: structuredDataProp,
  ogImage,
  ogType,
  index = true,
  wide = false,
  markdownAlternate,
  locale,
  alternateLanguages,
} = Astro.props;
const starsLabel = await githubStarsLabel();
const frameLocale: Locale = locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);
const skipLabel = getHomeCopy(frameLocale).skipToContent;
const structuredData =
  structuredDataProp ?? (faq && faq.length > 0 ? faqPageSchema(faq) : undefined);
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  localeAlternates={false}
  ogImage={ogImage}
  ogType={ogType}
  index={index}
  markdownAlternate={markdownAlternate}
  locale={locale}
  skipLabel={skipLabel}
  alternateLanguages={alternateLanguages}
>
  <div class="container">
    <Header starsLabel={starsLabel} locale={locale} />
    <main id="main" class:list={[wide ? "wide-page" : "alt-page"]}>
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>
