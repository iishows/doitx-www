---
import { DOCS_URL } from "../site";

interface Props {
  locale: string;
}

const { locale } = Astro.props;

function formatCardDate(iso: string): string {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? "" : d.toLocaleDateString(locale, { month: "short", day: "numeric" });
}
---

<aside class="repo-card" aria-label="Docs">
  <div class="repo-card__head">
    <svg class="repo-card__mark" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M5.5 3h9.2L19 6.9V21H5.5A2.5 2.5 0 0 1 3 18.5v-13A2.5 2.5 0 0 1 5.5 3Zm8.9.8v4h4.3l-4.3-4Zm-7.7 3.4c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6Zm2.7 0c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6Zm-2.7 2.9c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6Zm2.7 0c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6Zm-2.7 2.9c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6Zm2.7 0c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6Z"
        fill="currentColor"
      />
    </svg>
    <span class="repo-card__name">Docs</span>
    <a class="repo-card__meta" href={DOCS_URL} target="_blank" rel="noreferrer">
      doitx.ai/docs ↗
    </a>
  </div>
  <ul class="repo-card__changes" aria-label="Start here">
    <li>
      <a href={`${DOCS_URL}`} target="_blank" rel="noreferrer">
        <span class="repo-card__dot" aria-hidden="true"></span>
        <span class="repo-card__title">Read the documentation</span>
        <span class="repo-card__date">Start here</span>
      </a>
    </li>
    <li>
      <a href={`${DOCS_URL}#/installation`} target="_blank" rel="noreferrer">
        <span class="repo-card__dot" aria-hidden="true"></span>
        <span class="repo-card__title">Install Doitx</span>
        <span class="repo-card__date">Guides</span>
      </a>
    </li>
  </ul>
</aside>

<style>
  .repo-card {
    border: 1px solid var(--panel-line);
    border-radius: 16px;
    background: var(--panel-bg);
  }

  .repo-card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--panel-line);
  }

  .repo-card__mark {
    width: 20px;
    height: 20px;
    flex: none;
    fill: currentColor;
  }

  .repo-card__name {
    font-weight: 600;
  }

  .repo-card__meta {
    margin-left: auto;
    color: var(--panel-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-decoration: none;
  }

  .repo-card__changes {
    margin: 0;
    padding: 8px 0;
    list-style: none;
  }

  .repo-card__changes a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 22px;
    transition: background 160ms ease;
  }

  .repo-card__changes a:hover,
  .repo-card__changes a:focus-visible {
    background: var(--panel-line);
  }

  .repo-card__dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 999px;
    background: var(--success);
  }

  .repo-card__changes li:first-child .repo-card__dot {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--success) 25%, transparent);
  }

  .repo-card__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .repo-card__date {
    flex: none;
    color: var(--panel-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .repo-card__meta {
      display: none;
    }
  }
</style>
