---
import type { InstallCopy } from "../i18n/install";
import { getInstallCopy } from "../i18n/install";
import { fetchDesktopDownloads } from "../github";
import type { Locale } from "../i18n/locales";
import { DEFAULT_LOCALE } from "../i18n/locales";
import { APP_URL } from "../site";

type Props = {
  locale?: Locale;
  copy?: InstallCopy;
};

const { locale = DEFAULT_LOCALE, copy } = Astro.props;
const installCopy = copy ?? getInstallCopy(locale);
const downloads = await fetchDesktopDownloads();

const platforms = [
  { label: "Windows", href: downloads.windows },
  { label: "macOS", href: downloads.mac },
  { label: "Linux", href: downloads.linux },
  { label: "Web", href: `${APP_URL}/web` },
] as const;
---

<section id="install" class="section install">
  <div class="section-intro">
    <div class="eyebrow">{installCopy.eyebrow}</div>
    <h2 class="section-heading">{installCopy.heading}</h2>
    <p class="section-copy">{installCopy.copy}</p>
  </div>
  <div class="install-grid">
    {
      platforms.map((item) => (
        <a class="install-card install-card--link" href={item.href} target="_blank" rel="noopener">
          <h3>{item.label}</h3>
          <span class="install-card__hint">→</span>
        </a>
      ))
    }
  </div>
  <p class="install-note">{installCopy.note}</p>
</section>

<style>
  .install-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }

  .install-card--link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 16px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    background: var(--card, #fff);
    transition: border-color 0.15s, transform 0.15s;
  }

  .install-card--link:hover {
    border-color: var(--accent, #4f46e5);
    transform: translateY(-1px);
  }

  .install-card__hint {
    font-size: 14px;
    opacity: 0.5;
  }
</style>
