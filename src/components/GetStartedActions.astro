---
import type { HomeCopy } from "../i18n/home";
import type { DesktopDownloads } from "../github";
import { availableDesktopPlatforms, desktopDownloadHref } from "../github";
import { APP_URL } from "../site";

type Props = {
  class: string;
  copy: HomeCopy["hero"];
  /** Omitted where downloads stay on every platform. */
  downloads?: DesktopDownloads;
  /** PostHog `data-attr` prefix that tells this placement apart from others. */
  placement: string;
};

const { class: className, copy, downloads, placement } = Astro.props;

// `data-show` lists the platforms (set on <html> by the HomePage script) that see each action.
const desktopDownloads = (downloads ? availableDesktopPlatforms(downloads) : []).map((platform) => ({
  platform,
  label: copy.download[platform],
  href: desktopDownloadHref(platform),
}));
---

<div class={className}>
  <a class="button button--primary" href={APP_URL} data-show="mac windows linux web">
    {copy.getStarted}
  </a>
  {
    desktopDownloads.map((download) => (
      <a class="button button--secondary" href={download.href} data-show={download.platform}>
        {download.label}
      </a>
    ))
  }
</div>
